{
  "rules": {
    ".read": false,
    ".write": false,
    "servidores": {
      ".read": "auth != null && auth.token.firebase.sign_in_provider === 'anonymous' && root.child('claveTaller').isString() && root.child('claveTaller').val() === root.child('navegadoresTaller').child(auth.uid).val()",
      ".write": "auth != null && auth.token.firebase.sign_in_provider === 'anonymous' && root.child('claveTaller').isString() && root.child('claveTaller').val() === root.child('navegadoresTaller').child(auth.uid).val()"
    },
    "tareas_ia": {
      ".indexOn": [
        "estado"
      ],
      ".read": "auth != null && auth.token.firebase.sign_in_provider === 'anonymous' && root.child('claveTaller').isString() && root.child('claveTaller').val() === root.child('navegadoresTaller').child(auth.uid).val()",
      ".write": "auth != null && auth.token.firebase.sign_in_provider === 'anonymous' && root.child('claveTaller').isString() && root.child('claveTaller').val() === root.child('navegadoresTaller').child(auth.uid).val()"
    },
    "accesoTaller": {
      ".read": "auth != null && auth.token.firebase.sign_in_provider === 'anonymous' && root.child('claveTaller').isString() && root.child('claveTaller').val() === root.child('navegadoresTaller').child(auth.uid).val()"
    },
    "navegadoresTaller": {
      "$uid": {
        ".write": "auth != null && auth.token.firebase.sign_in_provider === 'anonymous' && auth.uid === $uid && (!newData.exists() || (newData.isString() && newData.val() === root.child('claveTaller').val()))"
      }
    }
  }
}
