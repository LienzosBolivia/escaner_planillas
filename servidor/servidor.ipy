from firebase_admin import auth as firebase_auth
_token_worker = None
_token_vence = 0

def token_worker():
    global _token_worker, _token_vence
    if time.monotonic() >= _token_vence:
        firmado = firebase_auth.create_custom_token("kaggle-taller").decode()
        resp = requests.post("https://identitytoolkit.googleapis.com/v1/accounts:signInWithCustomToken",
                             params={"key": FIREBASE_WEB_API_KEY}, json={"token":firmado,"returnSecureToken":True}, timeout=30)
        resp.raise_for_status()
        _token_worker = resp.json()["idToken"]
        _token_vence = time.monotonic() + 3000
    return _token_worker

SESION_ID = uuid.uuid4().hex
slot_ref = rtdb.reference(f"servidores/slot_{SLOT}")
def adquirir(actual):
    actual = actual or {}
    if actual.get("sesion_activa"):
        raise SystemExit("Slot ocupado. Compruebe la sesión en Kaggle.")
    return {**actual, "sesion_activa": SESION_ID, "interrumpir":False,
            "tipo_servidor": globals().get("TIPO_SERVIDOR", "cpu"), "estado":"iniciando",
            "actualizado": int(time.time() * 1000)}
slot_ref.transaction(adquirir)

class SesionReemplazada(SystemExit):
    pass

def con_sesion(actual, cambios):
    if not actual or actual.get("sesion_activa") != SESION_ID:
        raise SesionReemplazada("El slot pertenece a otra sesión.")
    return {**actual, **cambios}

def liberar_candado():
    try:
        slot_ref.transaction(lambda actual: con_sesion(actual, {"sesion_activa":""}))
    except (Exception, SesionReemplazada):
        pass
atexit.register(liberar_candado)

def reportar(estado_srv, progreso, mensaje, tarea_actual=None):
    """Refleja en Realtime Database, en tiempo real, exactamente lo que está
    pasando en los logs de este notebook (slot SLOT). RTDB usa PATCH directo
    a la URL del nodo con .json, sin updateMask ni tipado de campos."""
    print(mensaje)
    try:
        cuerpo = {
            "estado": str(estado_srv),
            "progreso": int(progreso),
            "mensaje": str(mensaje),
            "tarea_actual": str(tarea_actual or ""),
            "sesion": SESION_ID,
            "actualizado": int(time.time() * 1000)
        }
        slot_ref.transaction(lambda actual: con_sesion(actual, cuerpo))
    except Exception as e:
        print(f"⚠️ [REPORTAR] No se pudo avisar progreso: {e}")

reportar('iniciando', 2, f"🚀 [SLOT {SLOT}] Notebook arrancó (sesión {SESION_ID}). Preparando entorno...")

